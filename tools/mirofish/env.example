# MiroFish 설정 (중앙마이스터용) — MiroFish 폴더에 .env 이름으로 복사해서 사용
# 키는 이 파일(env.example)에 쓰지 말고, 복사한 .env 에만 넣으세요.

# ===== AI 두뇌: Gemini (OpenAI 호환 주소) =====
LLM_API_KEY=여기에_Gemini_키
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# 가상 인물 수백 명이 짧게 여러 번 호출하므로 가볍고 빠른 lite 모델이 맞습니다.
# (gemini-3.8-flash 같은 '생각하는' 모델은 답이 비어 오는 경우가 있어 비추천)
LLM_MODEL_NAME=gemini-3.5-flash-lite

# ===== 기억 저장소: Zep Cloud (https://app.getzep.com) =====
ZEP_API_KEY=여기에_Zep_키
